PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/angular_commerce
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/angular_commerce_test
CLIENT_URL=http://localhost:4200
ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SAME_SITE=lax
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_DIR=uploads
PG_POOL_MAX=5
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_SELLER_EMAIL=seller@example.com
SEED_SELLER_PASSWORD=
SEED_CUSTOMER_EMAIL=customer@example.com
